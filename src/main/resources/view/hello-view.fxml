<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" prefHeight="158.0" prefWidth="124.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="pe.edu.upeu.sysventas.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" />
    <Button onAction="#onHelloButtonClick" styleClass="btn, btn-primary" text="Hello!" textFill="#1011e0">
      <font>
         <Font name="System Bold Italic" size="12.0" />
      </font>
      <VBox.margin>
         <Insets bottom="10.0" left="5.0" right="5.0" top="5.0" />
      </VBox.margin>
      <padding>
         <Insets bottom="10.0" left="5.0" right="5.0" top="5.0" />
      </padding></Button>
</VBox>
